# ─── Aplicación ──────────────────────────────────────────────
APP_NAME=LotHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# ─── HTTPS en producción (US-TEC-001) ─────────────────────────
# true: redirige HTTP → HTTPS (301), agrega HSTS y genera los enlaces con https.
# Detrás de un proxy o balanceador indica sus IP (o * si el servidor solo es accesible por él).
FORCE_HTTPS=false
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false

# ─── Cartera ───────────────────────────────────────────────────
# Límite de usura vigente en % mensual (RN-19). Actualízalo con la certificación mensual de la Superfinanciera.
USURY_MONTHLY_RATE=2.10
# Días de gracia antes de liquidar intereses de mora (RN-19).
LATE_CHARGE_GRACE_DAYS=0
# Motor de asignación de pagos: puntaje mínimo (0-100) y margen sobre el segundo candidato.
ALLOCATION_AUTO_THRESHOLD=75
ALLOCATION_MIN_MARGIN=20

# ─── Pasarela Wompi (docs/PASARELA.md) ─────────────────────────
# URL de eventos para el panel de Wompi: {APP_URL}/pasarela/wompi/eventos
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_EXPIRATION_MINUTES=60
WOMPI_MIN_AMOUNT=10000

# ─── Base de datos (esquema: database/schema/cartera_inmobiliaria.sql) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cartera_inmobiliaria
DB_USERNAME=cartera_admin
DB_PASSWORD=

# Modelo de autenticación (vive en el módulo Security)
AUTH_MODEL=App\Models\Security\User

# ─── Infraestructura (sin tablas extra de Laravel) ──────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=daily
LOG_LEVEL=debug

# ─── Correo (recuperación de contraseña). "log" escribe en storage/logs ──
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@lothub.local
MAIL_FROM_NAME="${APP_NAME}"

# ─── Usuario administrador inicial (lo usa AdminUserSeeder) ──
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lothub.local
ADMIN_PASSWORD=

# ─── Plano interactivo (docs/PLANOS.md) ─────────────────────
# Intérprete del entorno virtual del procesador (ver docs/PLANOS.md).
# Windows: tools/plan-processor/.venv/Scripts/python.exe · Linux: tools/plan-processor/.venv/bin/python
PLAN_PYTHON=tools/plan-processor/.venv/Scripts/python.exe
# Conversor DWG→DXF de LibreDWG. Vacío = solo se aceptan archivos DXF.
# Tamaño máximo del plano (MB). php.ini debe permitir al menos esto (upload_max_filesize / post_max_size).
PLAN_MAX_MB=50
PLAN_DWG2DXF=
